{
  "name": "@hmydk/dsh-notify",
  "version": "0.1.1",
  "description": "Desktop notifications for DeepSeek Harness: alerts when a session finishes a turn or needs your approval.",
  "icon": "icon.svg",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/screenshots/*.png",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "notifications",
    "desktop"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HMYDK/dsh-notify.git"
  },
  "bugs": {
    "url": "https://github.com/HMYDK/dsh-notify/issues"
  },
  "homepage": "https://github.com/HMYDK/dsh-notify#readme",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
