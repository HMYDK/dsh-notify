#!/bin/sh
# Blocks direct pushes to protected branches. `main` may only change through a
# pull request, so refuse any push whose destination is refs/heads/main.
#
# Enable in a fresh clone with:
#   git config core.hooksPath .githooks
# (npm/pnpm shorthand: `npm run setup:hooks`)
#
# This hook is only fast local feedback; the server-side branch protection on
# GitHub is the actual enforcement. Tags are not affected.

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
	case "$remote_ref" in
	refs/heads/main) blocked=1 ;;
	esac
done

if [ "$blocked" -eq 1 ]; then
	cat >&2 <<'EOF'
✋ 拒绝直接 push 到 main / refusing to push to main.
   日常开发在 dev 分支，发版时再通过 PR 合入 main。

   1) git switch dev
   2) git add -A && git commit -m "..."
   3) git push                  # dev 允许直接 push

   改动需经 PR 进入 main；发布 tag 不受影响：git push origin vX.Y.Z
EOF
	exit 1
fi

exit 0
